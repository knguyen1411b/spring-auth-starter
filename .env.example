# Copy to .env for local development. Never commit .env.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
APP_PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_template
SPRING_DATASOURCE_USERNAME=auth
SPRING_DATASOURCE_PASSWORD=local-dev-only
# Replace with a cryptographically random secret of at least 64 UTF-8 bytes.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
PASSWORD_RESET_EXPIRATION=900000
PASSWORD_RESET_RESEND_COOLDOWN=60000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@example.test
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
BOOTSTRAP_ADMIN_ENABLED=false
SUPER_USER_USERNAME=
SUPER_USER_PASSWORD=
SUPER_USER_EMAIL=
SUPER_USER_FULL_NAME=Administrator
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=avatars
CLOUDINARY_PUBLIC_ID_PREFIX=user_

# Optional host port overrides for Docker Compose
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
